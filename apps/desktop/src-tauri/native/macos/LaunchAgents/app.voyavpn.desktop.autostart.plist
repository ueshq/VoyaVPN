<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The launch-at-login agent. The app registers it with
     SMAppService.agentServiceWithPlistName, which reads it from
     Contents/Library/LaunchAgents inside the signed bundle, so nothing is
     written outside the app (App Review Guideline 2.4.5(iii)). Label must equal
     the file name, and BundleProgram must name CFBundleExecutable;
     scripts/native/macos/verify-tunnel.mjs checks both. The flag after the
     program name is AUTOSTART_ARG in crates/voya-platform/src/autostart.rs. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.voyavpn.desktop.autostart</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/voyavpn</string>
  <key>ProgramArguments</key>
  <array>
    <string>voyavpn</string>
    <string>--autostart</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>app.voyavpn.desktop</string>
  </array>
</dict>
</plist>
