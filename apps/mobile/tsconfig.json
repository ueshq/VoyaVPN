{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The base config targets the DOM. React Native has no DOM, and letting
    // `document`/`window` typecheck here would hide real portability bugs until
    // runtime.
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "types": ["jest", "react-native"],
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  // `uniwind-env.d.ts` is generated by Metro and declares `className` on every
  // React Native component; without it every styled element fails to typecheck.
  "include": ["src", "uniwind-env.d.ts"]
}
