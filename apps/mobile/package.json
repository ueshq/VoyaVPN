  "license": "MIT",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "jest",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output .bundle-check/ios.jsbundle --assets-dest .bundle-check",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .bundle-check/android.jsbundle --assets-dest .bundle-check"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@tanstack/react-query": "^5.103.1",
    "@voya/client": "workspace:*",
    "@voya/i18n": "workspace:*",
    "react": "catalog:",
    "react-native": "0.87.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "uniwind": "1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "catalog:",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^29.7.0",
    "tailwindcss": "catalog:",
