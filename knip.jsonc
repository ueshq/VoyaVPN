{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "ignoreWorkspaces": ["apps/web"],
  "workspaces": {
    ".": {
      "ignoreBinaries": [
        "pgrep",
        "plutil",
        "system_profiler",
        "xcode-select"
      ]
    },
    "apps/mobile": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      // `global.css` is Uniwind's build input, reached from `index.js` and
      // compiled by Metro, so it belongs to the project rather than to the
      // ignore list; nothing imports *from* it.
      "project": ["src/**/*.{ts,tsx}", "global.css"],
      // Babel rewrites helper calls into `@babel/runtime` imports, so no
      // source file names it.
      "ignoreDependencies": ["@babel/runtime"],
      "ignoreIssues": {
        // gluestack components are copied into the repo, shadcn-style, and each
        // one is a unit: `Button` without `ButtonIcon` is a component we would
        // have to re-derive on the next copy. What keeps this directory small
        // is the "copy on demand" rule in src/components/ui/README.md, enforced
        // by the file-level scan, not by per-export usage.
        "src/components/ui/*/index.tsx": ["exports"]
      }
    },
    "apps/desktop": {
      "entry": ["src/**/*.{test,spec}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx,css}", "e2e/**/*.ts"],
      // flag-icons ships only SVG files, reached through `import.meta.glob`
      // in node-country-icon.tsx, which knip cannot follow.
      "ignoreDependencies": ["@tauri-apps/cli", "flag-icons"],
      "ignoreBinaries": ["tauri-driver"],
      "ignoreIssues": {
        "src/ipc/bindings.ts": ["duplicates", "enumMembers", "exports", "types"],
      // `commands.ts` is the desktop's implementation of the whole
      // `VoyaCommands` contract, consumed as a namespace by platform-boot.ts.
      // Completeness is the invariant here, not per-export usage, and the
      // `satisfies VoyaCommands` assertion is what enforces it.
        "src/ipc/commands.ts": ["exports"]
      }
    },
    "apps/probe": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // Deployment only: `pnpm --filter @voya/probe deploy` runs a wrangler the
      // operator installs, so it is not a workspace dependency.
      "ignoreBinaries": ["wrangler"],
      // `cloudflare:sockets` is a Workers runtime module, not a package.
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    // Generated from bindings.ts; every DTO is part of the contract whether or
    // not a frontend reads it today.
    "packages/contracts": {
      "project": ["src/**/*.ts"],
      "ignoreIssues": {
        "src/generated.ts": ["duplicates", "enumMembers", "exports", "types"],
        // The wire table exists for the native transports; the desktop's Tauri
        // binding has its own generated wrappers and never reads it.
        "src/commands.ts": ["exports"]
      }
    },
    "packages/client": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/features": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
