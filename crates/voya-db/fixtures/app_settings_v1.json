{
  "schemaVersion": 1,
  "appearance": {
    "language": "en",
    "theme": "system"
  },
  "behavior": {
    "autostart": false,
    "autoCheckIp": false
  },
  "core": {
    "logEnabled": false,
    "logLevel": "warn",
    "muxEnabled": false,
    "defaultAllowInsecure": false,
    "defaultFingerprint": "",
    "defaultUserAgent": "",
    "sendThrough": null,
    "bindInterface": null,
    "tlsFragment": "off",
    "fragmentFallbackDelayMs": 500,
    "cacheFileEnabled": true
  },
  "network": {
    "tun": {
      "enabled": false,
      "autoRoute": true,
      "strictRoute": false,
      "stack": "",
      "mtu": 1500,
      "ipv6Enabled": false,
      "icmpRouting": "rule"
    },
    "systemProxy": {
      "mode": "forcedClear",
      "exceptions": "localhost,127.0.0.0/8,::1",
      "bypassLocal": true
    },
    "inbounds": [
      {
        "localPort": 10808,
        "sniffingEnabled": true,
        "lanConnectionsAllowed": false,
        "separateLanPort": false,
        "username": "",
        "password": "",
        "secondaryPortEnabled": false
      }
    ]
  },
  "routing": {
    "domainStrategy": "AsIs"
  },
  "dns": {
    "addCommonHosts": null,
    "fakeIp": null,
    "globalFakeIp": null,
    "blockBindingQuery": null,
    "direct": null,
    "remote": null,
    "bootstrap": null,
    "directStrategy": null,
    "proxyStrategy": null,
    "hosts": null,
    "directExpectedIps": null
  },
  "speedTest": {
    "timeoutSeconds": 10,
    "latencyUrl": "https://www.google.com/generate_204",
    "ipLookupUrl": "",
    "pageSize": null,
    "delayIntervalSeconds": null
  },
  "multiplexing": {
    "protocol": "h2mux",
    "maxConnections": 8,
    "padding": null
  },
  "hysteria": {
    "uploadMbps": 100,
    "downloadMbps": 100,
    "hopIntervalSeconds": 30
  },
  "proxy": {
    "trafficMode": "rule"
  }
}
