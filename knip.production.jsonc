{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  // This scan hides test files so it can find code no shipped path reaches.
  // That also means an export whose only *external* reader is a test looks
  // dead here even when the module itself uses it — `StoredLogLine` (the
  // element type of the store's `logLines`) is that shape. Exports nothing
  // reads, in their own file or anywhere else, are
  // still reported, and the default scan above still checks reachability with
  // tests included.
  "ignoreExportsUsedInFile": true,
  "ignoreWorkspaces": [".", "apps/web"],
  "workspaces": {
    "apps/mobile": {
      "entry": ["index.js!"],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["src/**/*.test.{ts,tsx}", "src/test/**"],
      // Babel rewrites helper calls into `@babel/runtime` imports, so no
      // source file names it.
      "ignoreDependencies": ["@babel/runtime"]
    },
    "apps/desktop": {
      "entry": ["src/main.tsx!"],
      "project": ["src/**/*.{ts,tsx,css}!"],
      "ignore": ["e2e/**", "src/**/*.{test,spec}.{ts,tsx}", "src/**/*.test-fixture.ts", "src/test/**"],
      // flag-icons ships only SVG files, reached through `import.meta.glob`
      // in node-country-icon.tsx, which knip cannot follow.
      "ignoreDependencies": ["@tauri-apps/cli", "flag-icons"],
      "ignoreIssues": {
        "src/ipc/bindings.ts": ["duplicates", "enumMembers", "exports", "types"],
      // `commands.ts` is the desktop's implementation of the whole
      // `VoyaCommands` contract, consumed as a namespace by platform-boot.ts.
      // Completeness is the invariant here, not per-export usage, and the
      // `satisfies VoyaCommands` assertion is what enforces it.
        "src/ipc/commands.ts": ["exports"]
      }
    },
    "apps/probe": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"],
      "ignore": ["test/**"],
      "ignoreBinaries": ["wrangler"],
      // `cloudflare:sockets` is a Workers runtime module, not a package.
      "ignoreDependencies": ["cloudflare"]
    },
    "packages/i18n": {
      "entry": ["src/core.ts", "src/index.ts", "src/native.ts", "src/use-i18n.ts"],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["src/**/*.test.{ts,tsx}"]
    },
    "packages/ui": {
      "entry": ["src/components/*.{ts,tsx}", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx,css}!"],
      "ignore": ["src/**/*.test.{ts,tsx}", "src/test/setup.ts"]
    },
    "packages/utils": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.{ts,tsx}!"],
      "ignore": ["src/**/*.test.{ts,tsx}"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts", "src/commands.ts"],
      "project": ["src/**/*.ts!"],
      "ignoreIssues": {
        "src/generated.ts": ["duplicates", "enumMembers", "exports", "types"],
        // The wire table exists for the native transports; the desktop's Tauri
        // binding has its own generated wrappers and never reads it.
        "src/commands.ts": ["exports"]
      }
    },
    "packages/client": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts!"],
      // `test-storage.ts` is the storage seam tests register; it is deliberately
      // not reachable from a shipped path.
      "ignore": ["src/**/*.test.ts", "src/test-storage.ts"]
    },
    "packages/features": {
      "entry": ["src/*/*.{ts,tsx}!"],
      "project": ["src/**/*.{ts,tsx}!"],
      // `src/test` is the package's own harness and fixtures, deliberately not
      // reachable from a shipped path.
      "ignore": ["src/**/*.test.{ts,tsx}", "src/test/**"]
    }
  }
}
